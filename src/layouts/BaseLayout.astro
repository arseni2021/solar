---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { SITE, hasValue } from '../lib/site';
import { alternatePath, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  noIndex?: boolean;
  lang?: Lang;
}

const isPreview = import.meta.env.PUBLIC_PREVIEW === 'true';
const { title, description, noIndex = false, lang = 'ro' } = Astro.props;
const shouldNoIndex = noIndex || isPreview;
const canonicalURL = new URL(Astro.url.pathname, SITE.domain).toString();
const ogImage = new URL('/og-image.jpg', SITE.domain).toString();
const alt = alternatePath(Astro.url.pathname, lang);
const roAlternateURL = new URL(alt.ro, SITE.domain).toString();
const ruAlternateURL = new URL(alt.ru, SITE.domain).toString();

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.legalName,
  url: SITE.domain,
  logo: `${SITE.domain}/logo.png`,
  email: SITE.email,
  address: { '@type': 'PostalAddress', addressCountry: 'MD' },
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {shouldNoIndex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="alternate" hreflang="ro-MD" href={roAlternateURL} />
    <link rel="alternate" hreflang="ru-MD" href={ruAlternateURL} />
    <link rel="alternate" hreflang="x-default" href={roAlternateURL} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_MD' : 'ro_MD'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {hasValue(SITE.gscVerification) && <meta name="google-site-verification" content={SITE.gscVerification} />}

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body class="bg-white text-ink-900 font-body antialiased">
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <CookieConsent lang={lang} />
  </body>
</html>
