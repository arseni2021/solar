---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Calculator from '../components/Calculator.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { Icon } from 'astro-icon/components';
import { hasValue, SITE } from '../lib/site';

const caracteristici = [
  { icon: 'lucide:leaf', title: 'Origine regenerabilă', text: 'Energie preponderent din surse proprii și agregate, cu certificate de origine pentru raportare ESG.', href: '/pentru-afaceri/energie-verde-pentru-companii' },
  { icon: 'lucide:badge-percent', title: 'Prețuri transparente', text: 'Tarife clare și competitive, fără formule ascunse sau condiții neclare.', href: '/pentru-afaceri' },
  { icon: 'lucide:settings-2', title: 'Soluții personalizate', text: 'Contracte flexibile, autoconsum, stocare locală și optimizarea consumului pentru industrie.', href: '/pentru-afaceri/solutii-industriale' },
  hasValue(SITE.clientPlatformStatus)
    ? { icon: 'lucide:smartphone', title: 'Platformă digitală', text: 'Urmărirea consumului, facturare electronică, prognoză și suport tehnic online.', href: '/pentru-afaceri' }
    : { icon: 'lucide:headset', title: 'Suport dedicat', text: 'Răspundem direct, prin telefon și email, la orice întrebare legată de contract sau facturare.', href: '/contacte' },
];

const steps = [
  { icon: 'lucide:file-text', title: 'Trimiți o cerere', text: 'Completezi formularul cu consumul aproximativ al companiei.' },
  { icon: 'lucide:calculator', title: 'Primești o ofertă personalizată', text: 'În maximum 24 de ore, cu un preț clar, nu o promisiune vagă.' },
  { icon: 'lucide:file-signature', title: 'Semnezi contractul', text: 'Online sau la birou, fără vizită tehnică la sediul companiei.' },
  { icon: 'lucide:zap', title: 'Nimic nu se schimbă fizic', text: 'Aceeași rețea, același contor. Se schimbă doar furnizorul din factură.' },
];

const faqItems = [
  {
    question: 'Va fi întrerupere de curent dacă schimb furnizorul?',
    answer: 'Nu. Rețeaua electrică și contorul rămân neschimbate, se schimbă doar compania care îți facturează energia.',
  },
  {
    question: 'Cât durează procesul de schimbare a furnizorului?',
    answer: 'Depinde în primul rând de cât de repede sunt pregătite actele companiei. Trimite-ne o cerere de ofertă și îți spunem un termen concret pentru cazul tău.',
  },
  {
    question: 'Ce acte sunt necesare?',
    answer: 'În principal datele de identificare ale companiei și ultima factură de energie electrică. Lista completă este în <a href="/blog/acte-necesare-schimbare-furnizor">acest ghid</a>.',
  },
  {
    question: 'Pot reveni la furnizorul anterior dacă mă răzgândesc?',
    answer: 'Da, piața liberă îți permite oricând să alegi alt furnizor. Scrie-ne dacă vrei să discutăm exact ce înseamnă asta pentru compania ta.',
  },
  {
    question: 'Cine răspunde de mentenanța rețelei după ce schimb furnizorul?',
    answer: 'Operatorul de distribuție rămâne același, el se ocupă de rețea indiferent de furnizor.',
  },
];
---
<BaseLayout
  title="Ecosolar, furnizor licențiat ANRE de energie electrică pentru afaceri"
  description="Furnizor licențiat ANRE de energie electrică din surse regenerabile. Preț transparent, tranziție fără întreruperi. Solicită o ofertă în 2 minute."
>
  <section class="bg-ink-900 text-white relative overflow-hidden">
    <div class="absolute -top-32 -right-24 w-[560px] h-[560px] rounded-full bg-brand-500/20 blur-3xl pointer-events-none"></div>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16 sm:py-24 text-center relative">
      <span class="inline-flex items-center gap-2 bg-accent-500 text-ink-900 font-semibold text-sm rounded-full pl-2.5 pr-3.5 py-1.5 mb-5">
        <Icon name="lucide:badge-check" class="w-4 h-4" /> Furnizor licențiat ANRE
      </span>
      <h1 class="text-white mb-5">Energie electrică din surse regenerabile, la un preț transparent</h1>
      <p class="text-lg text-ink-100 mb-8 max-w-lg mx-auto">
        Furnizor licențiat ANRE de energie electrică din surse regenerabile pentru companii din Republica Moldova.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <Button href="/oferta" variant="primary" class="text-base">Solicită o ofertă →</Button>
        <Button href="#calculator" variant="ghost" class="text-base">Vezi cât ai plăti</Button>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 mt-8 text-sm text-ink-100">
        <span class="flex items-center gap-1.5 whitespace-nowrap"><Icon name="lucide:zap" class="w-4 h-4 text-brand-300" /> Fără întreruperi</span>
        <span class="w-1 h-1 rounded-full bg-ink-700"></span>
        <span class="flex items-center gap-1.5 whitespace-nowrap"><Icon name="lucide:clock" class="w-4 h-4 text-brand-300" /> Răspuns în 24h</span>
        <span class="w-1 h-1 rounded-full bg-ink-700"></span>
        <span class="flex items-center gap-1.5 whitespace-nowrap"><Icon name="lucide:activity" class="w-4 h-4 text-brand-300" /> Activi pe piața PRE</span>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
    <h2 class="text-center mb-3">Cum funcționează trecerea la Ecosolar</h2>
    <p class="text-center text-ink-700 max-w-xl mx-auto mb-12">
      Fără întrerupere de curent. Fără vizită tehnică. Rețeaua și contorul rămân aceleași.
    </p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((step, i) => (
        <div class="text-center">
          <span class="inline-flex items-center justify-center rounded-full bg-brand-100 p-4 mb-4">
            <Icon name={step.icon} class="w-7 h-7 text-brand-500" />
          </span>
          <p class="text-xs font-semibold text-brand-600 mb-1">Pasul {i + 1}</p>
          <h3 class="font-heading font-semibold text-lg text-ink-900 mb-2">{step.title}</h3>
          <p class="text-sm text-ink-700">{step.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-ink-50 py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <h2 class="text-center mb-3">Ce oferim companiilor din Moldova</h2>
      <p class="text-center text-ink-700 max-w-xl mx-auto mb-12">
        O singură ofertă de furnizare, construită în jurul a patru caracteristici concrete.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {caracteristici.map((c) => (
          <a href={c.href} class="block bg-white rounded-2xl shadow-sm hover:shadow-md border border-ink-100 p-6 transition-shadow">
            <span class="inline-flex items-center justify-center rounded-full bg-brand-100 p-3 mb-4">
              <Icon name={c.icon} class="w-6 h-6 text-brand-500" />
            </span>
            <h3 class="font-heading font-semibold text-lg text-ink-900 mb-2">{c.title}</h3>
            <p class="text-sm text-ink-700">{c.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="calculator" class="max-w-3xl mx-auto px-4 sm:px-6 py-16 sm:py-20 scroll-mt-20">
    <h2 class="text-center mb-3">Vezi cât ai plăti cu Ecosolar</h2>
    <p class="text-center text-ink-700 mb-10">
      Introdu consumul lunar și tariful actual, primești o ofertă de preț reală, nu o estimare generică.
    </p>
    <Calculator />
  </section>

  <section class="bg-ink-900 text-white py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <h2 class="text-white text-center mb-10">De ce Eco Solar Park</h2>
      <div class="grid sm:grid-cols-3 gap-8">
        <div class="text-center">
          <Icon name="lucide:badge-check" class="w-8 h-8 text-brand-300 mx-auto mb-3" />
          <p class="font-heading font-semibold mb-2">Furnizor licențiat ANRE</p>
          <p class="text-sm text-ink-100">
            {hasValue(SITE.anreLicenseNumber) ? (
              <>Licența nr. {SITE.anreLicenseNumber}, verificabilă</>
            ) : (
              <>Verificabilă</>
            )} în <a href="/despre-noi/licenta-si-transparenta" class="underline">registrul public ANRE</a>.
          </p>
        </div>
        <div class="text-center">
          <Icon name="lucide:activity" class="w-8 h-8 text-brand-300 mx-auto mb-3" />
          <p class="font-heading font-semibold mb-2">Prezență activă pe piața energiei</p>
          <p class="text-sm text-ink-100">
            Administrăm o <a href="/servicii-echilibrare-pre" class="underline">Parte Responsabilă cu Echilibrarea (PRE)</a> pentru producători din surse regenerabile.
          </p>
        </div>
        <div class="text-center">
          <Icon name="lucide:sun" class="w-8 h-8 text-brand-300 mx-auto mb-3" />
          <p class="font-heading font-semibold mb-2">Portofoliu din surse regenerabile</p>
          <p class="text-sm text-ink-100">
            Detalii verificabile despre capacitățile deținute, pe pagina de <a href="/despre-noi/licenta-si-transparenta" class="underline">transparență</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
    <h2 class="text-center mb-10">Întrebări frecvente</h2>
    <FAQAccordion items={faqItems} />
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16 sm:pb-20">
    <CtaBanner />
  </section>
</BaseLayout>
