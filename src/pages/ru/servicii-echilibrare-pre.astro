---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { Icon } from 'astro-icon/components';
import { SITE, hasValue } from '../../lib/site';

const activitati = [
  { icon: 'lucide:database', title: 'Обмен данными', text: 'Обмен данными и измеренными значениями с сетевыми операторами и Оператором системы и передачи (OST).' },
  { icon: 'lucide:radio', title: 'Передача уведомлений', text: 'Передача почасовых уведомлений через платформу Оптового рынка электроэнергии.' },
  { icon: 'lucide:clipboard-list', title: 'Обработка счетов', text: 'Приём, проверка и сверка счетов, полученных от операторов распределения.' },
  { icon: 'lucide:calculator', title: 'Расчёт дисбалансов', text: 'Расчёт дисбалансов и соответствующих издержек для каждого участника.' },
  { icon: 'lucide:file-text', title: 'Выставление счетов и отчётность', text: 'Выставление счетов и информационных справок каждому участнику на основе внутренней методологии перераспределения.' },
];
---
<BaseLayout
  lang="ru"
  title="Услуги балансирования (PRE) для производителей ВИЭ | Ecosolar"
  description="Eco Solar Park управляет Ответственной стороной по балансированию (PRE), платформой агрегации для производителей энергии из возобновляемых источников в Молдове."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    <Breadcrumbs items={[{ label: 'Главная', href: '/ru' }, { label: 'Услуги балансирования (PRE)' }]} />
    <span class="inline-flex items-center justify-center rounded-full bg-brand-100 p-3 mb-4">
      <Icon name="lucide:scale" class="w-6 h-6 text-brand-500" />
    </span>
    <h1 class="mb-4">Услуги балансирования (PRE), платформа агрегации для производителей</h1>
    <p class="text-lg text-ink-700 mb-10">
      Помимо поставки электроэнергии компаниям, Eco Solar Park управляет структурой агрегации, предназначенной
      для участников рынка электроэнергии, прежде всего производителей из возобновляемых источников, в форме
      Ответственной стороны по балансированию (PRE).
    </p>

    <div class="prose-article">
      <h2>Что такое Ответственная сторона по балансированию (PRE)</h2>
      <p>
        Любой производитель электроэнергии передаёт оператору системы прогноз своего производства. Разница между
        этим прогнозом и фактическим производством создаёт дисбаланс, финансово компенсируемый оператором
        системы. Ответственная сторона по балансированию объединяет нескольких участников в единый портфель, так
        что индивидуальные отклонения могут частично компенсировать друг друга, снижая общую стоимость дисбаланса
        для каждого участника.
        {hasValue(SITE.preParticipantsCount) && <> Группа, которой управляет Ecosolar, сейчас насчитывает {SITE.preParticipantsCount} активных производителей.</>}
      </p>

      <h2>Для кого эта услуга</h2>
      <p>
        Услуга адресована прежде всего производителям энергии из возобновляемых источников, солнечной и
        ветровой, заинтересованным в оптимизации разницы между переданными прогнозами производства и реальными
        значениями, без необходимости самостоятельно управлять административной и технической сложностью этого
        процесса.
      </p>

      <h2>Преимущества для участников</h2>
      <p>
        Присоединившись к прозрачно и профессионально управляемой PRE, участники получают снижение издержек,
        связанных с отрицательными дисбалансами, и максимизацию доходов от излишков произведённой энергии через
        справедливый, понятный механизм, ориентированный на коллективную эффективность группы.
      </p>

      <h2>Что мы делаем конкретно каждый месяц</h2>
    </div>

    <div class="not-prose grid sm:grid-cols-2 gap-5 my-8">
      {activitati.map((a) => (
        <div class="bg-white rounded-2xl border border-ink-100 p-5 flex gap-4">
          <span class="inline-flex items-center justify-center rounded-full bg-brand-100 p-2.5 h-fit shrink-0">
            <Icon name={a.icon} class="w-5 h-5 text-brand-500" />
          </span>
          <div>
            <p class="font-heading font-semibold text-ink-900 mb-1">{a.title}</p>
            <p class="text-sm text-ink-700">{a.text}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="prose-article">
      <h2>Чем эта услуга отличается от поставки электроэнергии</h2>
      <p>
        Поставка электроэнергии (см. <a href="/ru/pentru-afaceri">Для бизнеса</a>) адресована компаниям, которые
        <strong>потребляют</strong> электроэнергию. Услуга балансирования (PRE) адресована тем, кто
        <strong>производит</strong> электроэнергию из возобновляемых источников и хочет снизить финансовый риск,
        связанный с отклонениями от прогноза. Обе услуги можно использовать независимо друг от друга.
      </p>
    </div>

    <div class="mt-12">
      <CtaBanner
        lang="ru"
        compact
        title="Ты производитель энергии из возобновляемых источников?"
        subtitle="Напиши нам через форму контактов, указав в комментарии, что тебя интересует услуга балансирования (PRE)."
        href="/ru/contacte"
        buttonLabel="Связаться с нами"
      />
    </div>
  </div>
</BaseLayout>
