---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FAQAccordion from '../../../components/FAQAccordion.astro';
import CtaBanner from '../../../components/CtaBanner.astro';
import { Icon } from 'astro-icon/components';
import { SITE, hasValue } from '../../../lib/site';

const faqItems = [
  {
    question: 'Что значит «интеграция систем самопотребления»?',
    answer: 'Возможность сочетать энергию, произведённую на месте (например, собственными солнечными панелями), с энергией, поставляемой Ecosolar, так чтобы собственное потребление использовалось в приоритете, а оплачивалась только разница.',
  },
  {
    question: 'Вы предлагаете решения по локальному накоплению энергии?',
    answer: 'Да, договоры для промышленных потребителей могут включать решения по локальному накоплению, обсуждаемые индивидуально в зависимости от профиля потребления компании.',
  },
  {
    question: 'Насколько гибким может быть промышленный договор?',
    answer: 'Зависит от профиля твоей компании. Напиши нам детали потребления, и мы предложим подходящую структуру договора.',
  },
];
---
<BaseLayout
  lang="ru"
  title="Решения для промышленных потребителей | Ecosolar"
  description="Гибкие договоры, самопотребление, локальное накопление и оптимизация потребления для промышленных потребителей Молдовы."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    <Breadcrumbs items={[
      { label: 'Главная', href: '/ru' },
      { label: 'Для бизнеса', href: '/ru/pentru-afaceri' },
      { label: 'Решения для промышленности' },
    ]} />
    <span class="inline-flex items-center justify-center rounded-full bg-brand-100 p-3 mb-4">
      <Icon name="lucide:settings-2" class="w-6 h-6 text-brand-500" />
    </span>
    <h1 class="mb-4">Персонализированные решения для промышленных потребителей</h1>
    <p class="text-lg text-ink-700 mb-10">
      Для промышленных потребителей с предсказуемым и стабильным профилем потребления предлагаем гибкие
      договоры, с возможностью интеграции систем самопотребления, локального накопления и оптимизации
      потребления.
    </p>

    <div class="prose-article">
      <h2>Что мы понимаем под «персонализированными решениями»</h2>
      <ul>
        <li><strong>Гибкие договоры</strong>, адаптированные под профиль потребления каждого промышленного клиента.</li>
        <li><strong>Интеграция систем самопотребления:</strong> сочетание собственного производства клиента (например, солнечных панелей) с энергией, поставляемой Ecosolar.</li>
        <li><strong>Локальное накопление:</strong> решения, обсуждаемые индивидуально для заинтересованных клиентов.</li>
        <li><strong>Оптимизация потребления:</strong> корректировка профиля потребления для снижения расходов.</li>
      </ul>
      <p>
        Эти решения дополняют общие особенности услуги поставки, см.
        {' '}<a href="/ru/pentru-afaceri">Поставка электроэнергии</a> для полной картины.
      </p>
      {hasValue(SITE.ppaThresholdText) && (
        <p>
          Для потребителей с большим и предсказуемым объёмом энергии обсуждаем и вариант долгосрочного договора
          типа PPA (Power Purchase Agreement). {SITE.ppaThresholdText}
        </p>
      )}
    </div>

    <div class="my-10">
      <FAQAccordion items={faqItems} />
    </div>

    <CtaBanner lang="ru" compact title="У тебя промышленный профиль потребления?" subtitle="Напиши нам через форму контактов, выбрав «Поставка электроэнергии», и опиши профиль своей компании." />
  </div>
</BaseLayout>
