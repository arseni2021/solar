---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FAQAccordion from '../../../components/FAQAccordion.astro';
import CtaBanner from '../../../components/CtaBanner.astro';
import { Icon } from 'astro-icon/components';

const faqItems = [
  {
    question: 'Получаю ли я физически другие электроны в розетке с сертифицированной энергией?',
    answer: 'Нет, электросеть смешивает энергию из всех источников. Сертификат происхождения гарантирует, что для твоего потребления было произведено эквивалентное количество энергии из возобновляемых источников, без физического разделения потока энергии.',
  },
  {
    question: 'Какие документы я получаю для ESG-отчётности?',
    answer: 'Сертификат происхождения, соответствующий твоему потреблению, готовый к использованию напрямую в отчётах об устойчивом развитии компании.',
  },
  {
    question: 'Сертификат происхождения включён автоматически или запрашивается отдельно?',
    answer: 'Зависит от подписанного договора. Напиши нам, и мы скажем точно, как это работает для твоей компании.',
  },
];
---
<BaseLayout
  lang="ru"
  title="Сертифицированная зелёная энергия для компаний | Ecosolar"
  description="Энергия из возобновляемых источников с сертификатом происхождения для компаний Молдовы, поддержка ESG-отчётности."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    <Breadcrumbs items={[
      { label: 'Главная', href: '/ru' },
      { label: 'Для бизнеса', href: '/ru/pentru-afaceri' },
      { label: 'Сертифицированная зелёная энергия' },
    ]} />
    <span class="inline-flex items-center justify-center rounded-full bg-brand-100 p-3 mb-4">
      <Icon name="lucide:leaf" class="w-6 h-6 text-brand-500" />
    </span>
    <h1 class="mb-4">Энергия из возобновляемых источников с сертификатом происхождения</h1>
    <p class="text-lg text-ink-700 mb-10">
      Энергия, поставляемая Eco Solar Park, в основном происходит из возобновляемых источников, собственных и
      агрегированных. Для клиентов, заинтересованных в ESG-отчётности, мы можем выпускать сертификаты
      происхождения, подтверждающие возобновляемое происхождение потреблённой энергии.
    </p>

    <div class="prose-article">
      <h2>Как работает сертификат происхождения</h2>
      <p>
        Сертификат происхождения подтверждает, что количество энергии, эквивалентное твоему
        потреблению, было произведено из возобновляемых источников. Это стандартный инструмент, с помощью
        которого компания может документировать, с возможностью аудита, потребление зелёной энергии в рамках
        сертификатов, которые Ecosolar выдаёт клиентам для ESG-отчётности.
      </p>

      <h2>Для кого это актуально</h2>
      <ul>
        <li>Компании с европейскими клиентами или партнёрами, требующими подтверждения закупки возобновляемой энергии.</li>
        <li>Компании, готовящие или уже публикующие ESG-отчёты / отчёты об устойчивом развитии.</li>
        <li>Компании, желающие использовать зелёную энергию как коммерческий аргумент, подкреплённый проверяемым документом.</li>
      </ul>
    </div>

    <div class="my-10">
      <FAQAccordion items={faqItems} />
    </div>

    <CtaBanner lang="ru" compact title="Нужна сертифицированная энергия для твоей компании?" subtitle="Напиши нам через форму контактов, выбрав «Поставка электроэнергии» и указав интерес к сертификатам происхождения." />
  </div>
</BaseLayout>
