---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Calculator from '../../components/Calculator.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { Icon } from 'astro-icon/components';
import { hasValue, SITE } from '../../lib/site';

const caracteristici = [
  { icon: 'lucide:leaf', title: 'Возобновляемое происхождение', text: 'Энергия преимущественно из собственных и агрегированных источников, с сертификатами происхождения для ESG-отчётности.', href: '/ru/pentru-afaceri/energie-verde-pentru-companii' },
  { icon: 'lucide:badge-percent', title: 'Прозрачные цены', text: 'Понятные и конкурентные тарифы, без скрытых формул и неясных условий.', href: '/ru/pentru-afaceri' },
  { icon: 'lucide:settings-2', title: 'Персональные решения', text: 'Гибкие договоры, самопотребление, локальное накопление и оптимизация потребления для промышленности.', href: '/ru/pentru-afaceri/solutii-industriale' },
  hasValue(SITE.clientPlatformStatus)
    ? { icon: 'lucide:smartphone', title: 'Цифровая платформа', text: 'Отслеживание потребления, электронные счета, прогноз и онлайн техподдержка.', href: '/ru/pentru-afaceri' }
    : { icon: 'lucide:headset', title: 'Персональная поддержка', text: 'Отвечаем напрямую, по телефону и почте, на любой вопрос о договоре или счетах.', href: '/ru/contacte' },
];

const steps = [
  { icon: 'lucide:file-text', title: 'Отправляешь заявку', text: 'Заполняешь форму с примерным потреблением компании.' },
  { icon: 'lucide:calculator', title: 'Получаешь персональное предложение', text: 'В течение 24 часов, с чёткой ценой, а не расплывчатым обещанием.' },
  { icon: 'lucide:file-signature', title: 'Подписываешь договор', text: 'Онлайн или в офисе, без технического визита в компанию.' },
  { icon: 'lucide:zap', title: 'Физически ничего не меняется', text: 'Та же сеть, тот же счётчик. Меняется только поставщик в счёте.' },
];

const faqItems = [
  {
    question: 'Будет ли отключение электричества, если я сменю поставщика?',
    answer: 'Нет. Электросеть и счётчик остаются неизменными, меняется только компания, которая выставляет тебе счёт за энергию.',
  },
  {
    question: 'Сколько длится процесс смены поставщика?',
    answer: 'Зависит в первую очередь от того, как быстро подготовлены документы компании. Пришли нам заявку на предложение, и мы скажем точный срок для твоего случая.',
  },
  {
    question: 'Какие документы нужны?',
    answer: 'В основном идентификационные данные компании и последний счёт за электроэнергию. Полный список в <a href="/ru/blog/acte-necesare-schimbare-furnizor">этом руководстве</a>.',
  },
  {
    question: 'Могу ли я вернуться к прежнему поставщику, если передумаю?',
    answer: 'Да, свободный рынок позволяет в любой момент выбрать другого поставщика. Напиши нам, если хочешь обсудить, что это значит для твоей компании.',
  },
  {
    question: 'Кто отвечает за обслуживание сети после смены поставщика?',
    answer: 'Оператор распределения остаётся тем же, он занимается сетью независимо от поставщика.',
  },
];
---
<BaseLayout
  lang="ru"
  title="Ecosolar, поставщик электроэнергии для бизнеса, лицензированный ANRE"
  description="Поставщик электроэнергии из возобновляемых источников, лицензированный ANRE. Прозрачная цена, переход без перебоев. Запроси предложение за 2 минуты."
>
  <section class="bg-ink-900 text-white relative overflow-hidden">
    <div class="absolute -top-32 -right-24 w-[560px] h-[560px] rounded-full bg-brand-500/20 blur-3xl pointer-events-none"></div>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16 sm:py-24 text-center relative">
      <span class="inline-flex items-center gap-2 bg-accent-500 text-ink-900 font-semibold text-sm rounded-full pl-2.5 pr-3.5 py-1.5 mb-5">
        <Icon name="lucide:badge-check" class="w-4 h-4" /> Поставщик, лицензированный ANRE
      </span>
      <h1 class="text-white mb-5">Электроэнергия из возобновляемых источников по прозрачной цене</h1>
      <p class="text-lg text-ink-100 mb-8 max-w-lg mx-auto">
        Поставщик электроэнергии из возобновляемых источников, лицензированный ANRE, для компаний Республики Молдова.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <Button href="/ru/oferta" variant="primary" class="text-base">Запросить предложение →</Button>
        <Button href="#calculator" variant="ghost" class="text-base">Узнать, сколько я заплачу</Button>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 mt-8 text-sm text-ink-100">
        <span class="flex items-center gap-1.5 whitespace-nowrap"><Icon name="lucide:zap" class="w-4 h-4 text-brand-300" /> Без перебоев</span>
        <span class="w-1 h-1 rounded-full bg-ink-700"></span>
        <span class="flex items-center gap-1.5 whitespace-nowrap"><Icon name="lucide:clock" class="w-4 h-4 text-brand-300" /> Ответ за 24ч</span>
        <span class="w-1 h-1 rounded-full bg-ink-700"></span>
        <span class="flex items-center gap-1.5 whitespace-nowrap"><Icon name="lucide:activity" class="w-4 h-4 text-brand-300" /> Активны на рынке PRE</span>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
    <h2 class="text-center mb-3">Как проходит переход на Ecosolar</h2>
    <p class="text-center text-ink-700 max-w-xl mx-auto mb-12">
      Без отключения электричества. Без технического визита. Сеть и счётчик остаются прежними.
    </p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((step, i) => (
        <div class="text-center">
          <span class="inline-flex items-center justify-center rounded-full bg-brand-100 p-4 mb-4">
            <Icon name={step.icon} class="w-7 h-7 text-brand-500" />
          </span>
          <p class="text-xs font-semibold text-brand-600 mb-1">Шаг {i + 1}</p>
          <h3 class="font-heading font-semibold text-lg text-ink-900 mb-2">{step.title}</h3>
          <p class="text-sm text-ink-700">{step.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-ink-50 py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <h2 class="text-center mb-3">Что мы предлагаем компаниям Молдовы</h2>
      <p class="text-center text-ink-700 max-w-xl mx-auto mb-12">
        Единое предложение поставки, построенное вокруг четырёх конкретных особенностей.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {caracteristici.map((c) => (
          <a href={c.href} class="block bg-white rounded-2xl shadow-sm hover:shadow-md border border-ink-100 p-6 transition-shadow">
            <span class="inline-flex items-center justify-center rounded-full bg-brand-100 p-3 mb-4">
              <Icon name={c.icon} class="w-6 h-6 text-brand-500" />
            </span>
            <h3 class="font-heading font-semibold text-lg text-ink-900 mb-2">{c.title}</h3>
            <p class="text-sm text-ink-700">{c.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="calculator" class="max-w-3xl mx-auto px-4 sm:px-6 py-16 sm:py-20 scroll-mt-20">
    <h2 class="text-center mb-3">Узнай, сколько будешь платить с Ecosolar</h2>
    <p class="text-center text-ink-700 mb-10">
      Введи месячное потребление и текущий тариф, получишь реальное предложение, а не общую оценку.
    </p>
    <Calculator lang="ru" />
  </section>

  <section class="bg-ink-900 text-white py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <h2 class="text-white text-center mb-10">Почему Eco Solar Park</h2>
      <div class="grid sm:grid-cols-3 gap-8">
        <div class="text-center">
          <Icon name="lucide:badge-check" class="w-8 h-8 text-brand-300 mx-auto mb-3" />
          <p class="font-heading font-semibold mb-2">Поставщик, лицензированный ANRE</p>
          <p class="text-sm text-ink-100">
            {hasValue(SITE.anreLicenseNumber) ? (
              <>Лицензия № {SITE.anreLicenseNumber}, проверяемая</>
            ) : (
              <>Проверяемая</>
            )} в <a href="/ru/despre-noi/licenta-si-transparenta" class="underline">публичном реестре ANRE</a>.
          </p>
        </div>
        <div class="text-center">
          <Icon name="lucide:activity" class="w-8 h-8 text-brand-300 mx-auto mb-3" />
          <p class="font-heading font-semibold mb-2">Активное присутствие на рынке энергии</p>
          <p class="text-sm text-ink-100">
            Управляем <a href="/ru/servicii-echilibrare-pre" class="underline">Ответственной стороной по балансированию (PRE)</a> для производителей ВИЭ.
          </p>
        </div>
        <div class="text-center">
          <Icon name="lucide:sun" class="w-8 h-8 text-brand-300 mx-auto mb-3" />
          <p class="font-heading font-semibold mb-2">Портфель из возобновляемых источников</p>
          <p class="text-sm text-ink-100">
            Проверяемые данные о мощностях на странице <a href="/ru/despre-noi/licenta-si-transparenta" class="underline">прозрачности</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
    <h2 class="text-center mb-10">Часто задаваемые вопросы</h2>
    <FAQAccordion items={faqItems} />
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16 sm:pb-20">
    <CtaBanner lang="ru" />
  </section>
</BaseLayout>
