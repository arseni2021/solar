---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { articleHref, SITE, hasValue } from '../../lib/site';
import { Icon } from 'astro-icon/components';

const articles = [
  { title: 'Как сменить поставщика электроэнергии', slug: 'cum-schimb-furnizorul' },
  { title: 'Какие документы нужны для смены поставщика', slug: 'acte-necesare-schimbare-furnizor' },
  { title: 'Кто может выйти на свободный рынок электроэнергии', slug: 'cine-poate-iesi-pe-piata-libera' },
  { title: 'Поставщик последней инстанции против поставщика на свободном рынке', slug: 'furnizor-ultima-optiune-vs-piata-libera' },
  { title: 'Что происходит со счётчиком при смене поставщика', slug: 'ce-se-intampla-cu-contorul' },
  { title: 'Будет ли отключение электричества при смене поставщика', slug: 'va-fi-intrerupere-de-curent' },
];

const faqItems = [
  {
    question: 'Что такое свободный рынок электроэнергии?',
    answer: 'Сегмент рынка, где компания сама выбирает поставщика электроэнергии вместо поставщика по умолчанию, напрямую договариваясь о цене и условиях.',
  },
  {
    question: 'Могут ли малые компании выйти на свободный рынок или только крупные потребители?',
    answer: 'Свободный рынок в Молдове больше не зарезервирован только для крупных потребителей. Подробности для твоей ситуации в <a href="/ru/blog/cine-poate-iesi-pe-piata-libera">этой статье</a>.',
  },
  {
    question: 'Что будет, если я останусь без поставщика на свободном рынке?',
    answer: 'Подключается поставщик последней инстанции, который временно берёт на себя снабжение по регулируемой цене на ограниченный законом срок. Подробности в <a href="/ru/blog/furnizor-ultima-optiune-vs-piata-libera">этой статье</a>.',
  },
  {
    question: 'Переход на свободный рынок связан с каким-то отключением или работами на сети?',
    answer: 'Нет. Распределительная сеть и счётчик остаются точно такими же, независимо от поставщика. Подробности в <a href="/ru/blog/ce-se-intampla-cu-contorul">этой статье</a>.',
  },
];

if (hasValue(SITE.switchingProcessingDays)) {
  faqItems.push({
    question: 'Сколько длится обработка заявки на смену поставщика?',
    answer: `${SITE.switchingProcessingDays}`,
  });
}
if (hasValue(SITE.returnToRegulatedSupplierNote)) {
  faqItems.push({
    question: 'Могу ли я вернуться к регулируемому поставщику, если передумаю?',
    answer: `${SITE.returnToRegulatedSupplierNote}`,
  });
}
---
<BaseLayout
  lang="ru"
  title="Свободный рынок электроэнергии в Молдове | Ecosolar"
  description="Что такое свободный рынок электроэнергии в Республике Молдова, кто может сам выбрать поставщика и как проходит смена на практике."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    <Breadcrumbs items={[{ label: 'Главная', href: '/ru' }, { label: 'Свободный рынок' }]} />
    <h1 class="mb-4">Свободный рынок электроэнергии в Республике Молдова</h1>
    <p class="text-lg text-ink-700 max-w-2xl mb-10">
      Краткое руководство для компании, которая рассматривает возможность самостоятельно выбрать поставщика
      электроэнергии вместо поставщика по умолчанию.
    </p>

    <div class="prose-article">
      <h2>Что такое свободный рынок</h2>
      <p>
        Свободный (или конкурентный) рынок электроэнергии это сегмент рынка, где поставка больше не назначается
        автоматически государством: компания сама выбирает поставщика среди лицензированных ANRE (Национальным
        агентством по регулированию в энергетике) и напрямую договаривается о цене. Правовая база установлена
        Законом № 107/2016 об электроэнергии, который разделил производство, транспортировку, распределение и
        поставку именно для того, чтобы сделать такой выбор возможным.
      </p>

      <h2>Кто регулирует рынок</h2>
      <p>
        ANRE лицензирует поставщиков, утверждает правила рынка и следит за их соблюдением. Сеть передачи и
        распределения остаётся регулируемой услугой, отдельной от поставки, независимо от того, на каком рынке
        находится компания. Eco Solar Park является поставщиком электроэнергии из возобновляемых источников,
        лицензированным ANRE.
      </p>

      <h2>Оптовый рынок за кулисами</h2>
      <p>
        С декабря 2025 года в Республике Молдова есть собственные организованные рынки электроэнергии, которыми
        управляет OPEM (Оператор рынка энергии): рынок на сутки вперёд (PZU), запущенный 10 декабря 2025 года, и
        внутрисуточный рынок (PPZ), запущенный 17 декабря 2025 года, разработанные при поддержке румынского
        оператора OPCOM. Эти рынки лежат в основе того, как поставщики закупают энергию, которую перепродают
        компаниям.
        {hasValue(SITE.wholesaleMarketNote) && <> {SITE.wholesaleMarketNote}</>}
      </p>

      <h2>Два практических шага</h2>
      <p>
        Для компании переход на свободный рынок означает, по сути, два шага: (1) выбор поставщика и подписание
        договора поставки и (2) уведомление оператора распределения новым поставщиком, без какого-либо физического
        вмешательства на месте потребления. Точные шаги с необходимыми документами описаны в статьях ниже.
      </p>
    </div>

    <h2 class="mb-5 mt-12">Статьи о свободном рынке</h2>
    <div class="grid sm:grid-cols-2 gap-4 mb-14">
      {articles.map((a) => (
        <a href={articleHref('ru', a.slug)} class="flex items-center justify-between gap-3 bg-white rounded-xl border border-ink-100 p-5 hover:shadow-md transition-shadow">
          <span class="font-heading font-semibold text-ink-900">{a.title}</span>
          <Icon name="lucide:arrow-right" class="w-4 h-4 text-brand-500 shrink-0" />
        </a>
      ))}
    </div>

    <h2 class="text-center mb-10">Часто задаваемые вопросы</h2>
    <FAQAccordion items={faqItems} />

    <div class="mt-12">
      <CtaBanner lang="ru" />
    </div>
  </div>
</BaseLayout>
