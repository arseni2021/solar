---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Calculator from '../../components/Calculator.astro';
import CtaBanner from '../../components/CtaBanner.astro';
---
<BaseLayout
  lang="ru"
  title="Калькулятор экономии на электроэнергии для бизнеса"
  description="Пришли нам месячное потребление и свой текущий тариф, получи точное ценовое предложение по электроэнергии для компании."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    <Breadcrumbs items={[{ label: 'Главная', href: '/ru' }, { label: 'Калькулятор экономии' }]} />
    <h1 class="mb-4">Узнай, сколько будешь платить с Ecosolar</h1>
    <p class="text-lg text-ink-700 mb-10">
      Введи примерное месячное потребление компании и текущий оплачиваемый тариф. Мы не показываем придуманную
      цифру, а присылаем реальное ценовое предложение, рассчитанное по нашему текущему тарифу.
    </p>

    <Calculator lang="ru" />

    <div class="mt-12">
      <CtaBanner lang="ru" />
    </div>
  </div>
</BaseLayout>
