---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { Icon } from 'astro-icon/components';
import { SITE, hasValue } from '../../lib/site';

const faqItems = [
  {
    question: 'Ce înseamnă „integrarea sistemelor de autoconsum”?',
    answer: 'Posibilitatea de a combina energia produsă la fața locului (de exemplu, panouri solare proprii) cu energia furnizată de Ecosolar, astfel încât consumul propriu să fie folosit prioritar și doar diferența să fie facturată.',
  },
  {
    question: 'Oferiți și soluții de stocare locală?',
    answer: 'Da, contractele pentru consumatori industriali pot integra soluții de stocare locală, discutate individual în funcție de profilul de consum al companiei.',
  },
  {
    question: 'Cât de flexibil poate fi un contract industrial?',
    answer: 'Depinde de profilul companiei tale. Scrie-ne detaliile consumului și îți propunem structura de contract potrivită.',
  },
];
---
<BaseLayout
  title="Soluții pentru consumatori industriali | Ecosolar"
  description="Contracte flexibile, autoconsum, stocare locală și optimizarea consumului pentru consumatori industriali din Republica Moldova."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    <Breadcrumbs items={[
      { label: 'Acasă', href: '/' },
      { label: 'Pentru afaceri', href: '/pentru-afaceri' },
      { label: 'Soluții pentru industrie' },
    ]} />
    <span class="inline-flex items-center justify-center rounded-full bg-brand-100 p-3 mb-4">
      <Icon name="lucide:settings-2" class="w-6 h-6 text-brand-500" />
    </span>
    <h1 class="mb-4">Soluții personalizate pentru consumatori industriali</h1>
    <p class="text-lg text-ink-700 mb-10">
      Pentru consumatorii industriali cu profil de consum predictibil și constant, oferim contracte flexibile, cu
      posibilitatea de integrare a sistemelor de autoconsum, stocare locală și optimizare a consumului.
    </p>

    <div class="prose-article">
      <h2>Ce înțelegem prin „soluții personalizate”</h2>
      <ul>
        <li><strong>Contracte flexibile</strong>, adaptate profilului de consum al fiecărui client industrial.</li>
        <li><strong>Integrarea sistemelor de autoconsum:</strong> combinarea producției proprii a clientului (de exemplu, panouri solare) cu energia furnizată de Ecosolar.</li>
        <li><strong>Stocare locală:</strong> soluții discutate individual pentru clienții interesați.</li>
        <li><strong>Optimizarea consumului:</strong> ajustarea profilului de consum pentru reducerea costurilor.</li>
      </ul>
      <p>
        Aceste soluții se adaugă caracteristicilor generale ale serviciului de furnizare, vezi
        {' '}<a href="/pentru-afaceri">Furnizarea energiei electrice</a> pentru imaginea completă.
      </p>
      {hasValue(SITE.ppaThresholdText) && (
        <p>
          Pentru consumatori cu un volum mare și predictibil de energie, discutăm și opțiunea unui contract pe
          termen lung de tip PPA (Power Purchase Agreement). {SITE.ppaThresholdText}
        </p>
      )}
    </div>

    <div class="my-10">
      <FAQAccordion items={faqItems} />
    </div>

    <CtaBanner compact title="Ai un profil de consum industrial?" subtitle="Scrie-ne prin formularul de contact, selectând «Furnizarea energiei electrice», și descrie profilul companiei tale." />
  </div>
</BaseLayout>
