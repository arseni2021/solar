---
import { Icon } from 'astro-icon/components';

export interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
  schema?: boolean;
}

const { items, schema = true } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---
<div class="divide-y divide-ink-100 border-t border-b border-ink-100">
  {items.map((item) => (
    <details class="group py-4">
      <summary class="flex items-center justify-between cursor-pointer list-none font-heading font-semibold text-ink-900 pr-2">
        <span>{item.question}</span>
        <Icon name="lucide:chevron-down" class="chevron w-5 h-5 text-brand-500 shrink-0" />
      </summary>
      <p class="mt-3 text-ink-700" set:html={item.answer} />
    </details>
  ))}
</div>
{schema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}
