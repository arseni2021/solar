---
import { Icon } from 'astro-icon/components';
import { UI, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  href: string;
  cluster: string;
  lang?: Lang;
}
const { title, description, href, cluster, lang = 'ro' } = Astro.props;
---
<a href={href} class="block bg-white rounded-2xl shadow-sm hover:shadow-md border border-ink-100 p-6 transition-shadow group h-full flex flex-col">
  <span class="inline-block text-xs font-semibold text-brand-600 bg-brand-50 rounded-full px-3 py-1 mb-3 w-fit">
    {cluster}
  </span>
  <h3 class="font-heading font-semibold text-lg text-ink-900 mb-2 flex-1">{title}</h3>
  <p class="text-sm text-ink-700 mb-4">{description}</p>
  <span class="inline-flex items-center gap-1 text-brand-600 font-semibold text-sm group-hover:gap-2 transition-all">
    {UI[lang].readMore} <Icon name="lucide:arrow-right" class="w-4 h-4" />
  </span>
</a>
