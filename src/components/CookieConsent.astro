---
import { SITE } from '../lib/site';
import { localizedHref, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'ro' } = Astro.props;

const copy = {
  ro: {
    message: 'Folosim cookie-uri pentru funcționarea site-ului și, cu acordul tău, pentru analiză de trafic și publicitate.',
    policyLink: 'Politica de cookie-uri',
    acceptAll: 'Acceptă toate',
    rejectAll: 'Respinge opționale',
    customize: 'Personalizează',
    save: 'Salvează preferințele',
    back: 'Înapoi',
    necessaryTitle: 'Strict necesare',
    necessaryDesc: 'Necesare pentru funcționarea de bază a site-ului. Nu pot fi dezactivate.',
    analyticsTitle: 'Analitice',
    analyticsDesc: 'Ne ajută să înțelegem cum este folosit site-ul (Google Analytics, Microsoft Clarity).',
    advertisingTitle: 'Publicitare',
    advertisingDesc: 'Măsoară eficiența campaniilor publicitare (Bing/Microsoft Advertising).',
  },
  ru: {
    message: 'Мы используем cookie для работы сайта и, с твоего согласия, для аналитики и рекламы.',
    policyLink: 'Политика cookie',
    acceptAll: 'Принять все',
    rejectAll: 'Отклонить необязательные',
    customize: 'Настроить',
    save: 'Сохранить настройки',
    back: 'Назад',
    necessaryTitle: 'Строго необходимые',
    necessaryDesc: 'Нужны для базовой работы сайта. Их нельзя отключить.',
    analyticsTitle: 'Аналитические',
    analyticsDesc: 'Помогают понять, как используется сайт (Google Analytics, Microsoft Clarity).',
    advertisingTitle: 'Рекламные',
    advertisingDesc: 'Оценивают эффективность рекламных кампаний (Bing/Microsoft Advertising).',
  },
}[lang];

const policyHref = localizedHref(lang, '/politica-cookie');
---
<div
  id="ecosolar-cookie-banner"
  class="fixed inset-x-0 bottom-0 z-[100] hidden p-4 sm:p-6"
  data-ga4-id={SITE.ga4Id}
  data-clarity-id={SITE.clarityId}
  data-bing-uet-id={SITE.bingUetTagId}
>
  <div class="max-w-3xl mx-auto bg-white text-ink-900 rounded-2xl shadow-2xl border border-ink-100 p-5 sm:p-6">
    <div data-cookie-view="banner">
      <p class="text-sm text-ink-700 mb-4">
        {copy.message} <a href={policyHref} class="underline text-brand-600">{copy.policyLink}</a>.
      </p>
      <div class="flex flex-wrap gap-2.5">
        <button type="button" data-cookie-accept-all class="px-4 py-2 rounded-lg text-sm font-semibold bg-brand-500 hover:bg-brand-600 text-white">
          {copy.acceptAll}
        </button>
        <button type="button" data-cookie-reject-all class="px-4 py-2 rounded-lg text-sm font-semibold bg-ink-50 hover:bg-ink-100 text-ink-900">
          {copy.rejectAll}
        </button>
        <button type="button" data-cookie-customize class="px-4 py-2 rounded-lg text-sm font-semibold border border-ink-100 hover:bg-ink-50 text-ink-900">
          {copy.customize}
        </button>
      </div>
    </div>

    <div data-cookie-view="panel" class="hidden">
      <div class="space-y-4 mb-5">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="font-heading font-semibold text-sm text-ink-900">{copy.necessaryTitle}</p>
            <p class="text-xs text-ink-400">{copy.necessaryDesc}</p>
          </div>
          <input type="checkbox" checked disabled class="mt-1 shrink-0 w-4 h-4" />
        </div>
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="font-heading font-semibold text-sm text-ink-900">{copy.analyticsTitle}</p>
            <p class="text-xs text-ink-400">{copy.analyticsDesc}</p>
          </div>
          <input type="checkbox" data-cookie-toggle="analytics" class="mt-1 shrink-0 w-4 h-4" />
        </div>
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="font-heading font-semibold text-sm text-ink-900">{copy.advertisingTitle}</p>
            <p class="text-xs text-ink-400">{copy.advertisingDesc}</p>
          </div>
          <input type="checkbox" data-cookie-toggle="advertising" class="mt-1 shrink-0 w-4 h-4" />
        </div>
      </div>
      <div class="flex flex-wrap gap-2.5">
        <button type="button" data-cookie-save class="px-4 py-2 rounded-lg text-sm font-semibold bg-brand-500 hover:bg-brand-600 text-white">
          {copy.save}
        </button>
        <button type="button" data-cookie-back class="px-4 py-2 rounded-lg text-sm font-semibold border border-ink-100 hover:bg-ink-50 text-ink-900">
          {copy.back}
        </button>
      </div>
    </div>
  </div>
</div>

<script src="../scripts/cookie-consent.js"></script>
