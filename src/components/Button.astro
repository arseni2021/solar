---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  class?: string;
  id?: string;
}
const { href, variant = 'primary', class: className = '', id } = Astro.props;

const base = 'inline-flex items-center justify-center gap-2 font-heading font-semibold rounded-lg px-6 py-3 transition-colors';
const variants = {
  primary: 'bg-brand-500 hover:bg-brand-600 text-white',
  secondary: 'border border-ink-900 text-ink-900 hover:bg-ink-50',
  ghost: 'border border-white/30 text-white hover:bg-white/10',
};
---
<a id={id} href={href} class={`${base} ${variants[variant]} ${className}`}>
  <slot />
</a>
