---
import { Icon } from 'astro-icon/components';
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = '' } = Astro.props;
---
<span class={`inline-flex items-center justify-center rounded-full bg-brand-100 p-3 ${className}`}>
  <Icon name={name} class="w-6 h-6 text-brand-500" />
</span>
