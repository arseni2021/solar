---
import { Icon } from 'astro-icon/components';
import { SITE } from '../lib/site';

export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
  lang?: 'ro' | 'ru';
}
const { items } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: `${SITE.domain}${item.href}` } : {}),
  })),
};
---
<nav aria-label="breadcrumb" class="text-sm text-ink-400 mb-6">
  <ol class="flex flex-wrap items-center gap-1">
    {items.map((item, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && <Icon name="lucide:chevron-right" class="w-3.5 h-3.5" />}
        {item.href ? (
          <a href={item.href} class="hover:text-brand-600">{item.label}</a>
        ) : (
          <span class="text-ink-700">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
