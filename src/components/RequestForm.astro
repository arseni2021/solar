---
import { SITE } from '../lib/site';
import { UI, localizedHref, type Lang } from '../lib/i18n';

interface Props {
  compact?: boolean;
  id?: string;
  lang?: Lang;
}
const { compact = false, id = 'form', lang = 'ro' } = Astro.props;

const copy = {
  ro: {
    subject: 'Cerere ofertă de pe ecosolar.md',
    companie: 'Numele companiei',
    numeContact: 'Nume și prenume',
    telefon: 'Telefon',
    email: 'Email',
    consumLunar: 'Consum lunar aproximativ',
    consumPlaceholder: 'Alege un interval',
    consum1: 'Până la 2 000 kWh',
    consum2: '2 000 – 10 000 kWh',
    consum3: '10 000 – 50 000 kWh',
    consum4: 'Peste 50 000 kWh',
    serviciuInteres: 'Serviciul de interes',
    serviciuPlaceholder: 'Selectați serviciul',
    serviciuFurnizare: 'Furnizarea energiei electrice',
    serviciuPRE: 'Servicii de echilibrare (PRE)',
    serviciuConsultanta: 'Consultanță',
    serviciuParteneriat: 'Parteneriat',
    serviciuAltceva: 'Altceva',
    comentariu: 'Comentariu (opțional)',
    consimtPre: 'Sunt de acord cu',
    consimtLink: 'prelucrarea datelor cu caracter personal',
    consimtPost: '.',
    submit: UI.ro.requestOffer,
    success: 'Mulțumim! Îți vom răspunde în maximum 24 de ore.',
    errorPre: 'A apărut o eroare la trimitere. Te rugăm să încerci din nou sau să ne scrii direct la',
  },
  ru: {
    subject: 'Запрос предложения с ecosolar.md',
    companie: 'Название компании',
    numeContact: 'Имя и фамилия',
    telefon: 'Телефон',
    email: 'Email',
    consumLunar: 'Примерное месячное потребление',
    consumPlaceholder: 'Выбери диапазон',
    consum1: 'До 2 000 кВт·ч',
    consum2: '2 000 – 10 000 кВт·ч',
    consum3: '10 000 – 50 000 кВт·ч',
    consum4: 'Более 50 000 кВт·ч',
    serviciuInteres: 'Интересующая услуга',
    serviciuPlaceholder: 'Выберите услугу',
    serviciuFurnizare: 'Поставка электроэнергии',
    serviciuPRE: 'Услуги балансирования (PRE)',
    serviciuConsultanta: 'Консультация',
    serviciuParteneriat: 'Партнёрство',
    serviciuAltceva: 'Другое',
    comentariu: 'Комментарий (необязательно)',
    consimtPre: 'Согласен(на) с',
    consimtLink: 'обработкой персональных данных',
    consimtPost: '.',
    submit: UI.ru.requestOffer,
    success: 'Спасибо! Мы ответим в течение 24 часов.',
    errorPre: 'При отправке произошла ошибка. Попробуй ещё раз или напиши нам напрямую на',
  },
}[lang];
---
<div id={id} class={`bg-white rounded-2xl border border-ink-100 shadow-sm ${compact ? 'p-6' : 'p-6 sm:p-10'}`}>
  <form
    class="request-form grid gap-4"
    action="https://api.web3forms.com/submit"
    method="POST"
  >
    <input type="hidden" name="access_key" value={SITE.web3formsKey} />
    <input type="hidden" name="subject" value={copy.subject} />
    <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label for="companie" class="block text-sm font-medium text-ink-700 mb-1">{copy.companie}</label>
        <input id="companie" type="text" name="companie" required class="w-full rounded-lg border border-ink-100 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500" />
      </div>
      <div>
        <label for="nume_contact" class="block text-sm font-medium text-ink-700 mb-1">{copy.numeContact}</label>
        <input id="nume_contact" type="text" name="nume_contact" required class="w-full rounded-lg border border-ink-100 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500" />
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label for="telefon" class="block text-sm font-medium text-ink-700 mb-1">{copy.telefon}</label>
        <input id="telefon" type="tel" name="telefon" required class="w-full rounded-lg border border-ink-100 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500" />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-ink-700 mb-1">{copy.email}</label>
        <input id="email" type="email" name="email" required class="w-full rounded-lg border border-ink-100 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500" />
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label for="consum_lunar" class="block text-sm font-medium text-ink-700 mb-1">{copy.consumLunar}</label>
        <select id="consum_lunar" name="consum_lunar" class="w-full rounded-lg border border-ink-100 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="">{copy.consumPlaceholder}</option>
          <option value="0-2000">{copy.consum1}</option>
          <option value="2000-10000">{copy.consum2}</option>
          <option value="10000-50000">{copy.consum3}</option>
          <option value="50000+">{copy.consum4}</option>
        </select>
      </div>
      <div>
        <label for="serviciu_interes" class="block text-sm font-medium text-ink-700 mb-1">{copy.serviciuInteres}</label>
        <select id="serviciu_interes" name="serviciu_interes" required class="w-full rounded-lg border border-ink-100 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="">{copy.serviciuPlaceholder}</option>
          <option value="furnizare">{copy.serviciuFurnizare}</option>
          <option value="pre">{copy.serviciuPRE}</option>
          <option value="consultanta">{copy.serviciuConsultanta}</option>
          <option value="parteneriat">{copy.serviciuParteneriat}</option>
          <option value="altceva">{copy.serviciuAltceva}</option>
        </select>
      </div>
    </div>

    <div>
      <label for="comentariu" class="block text-sm font-medium text-ink-700 mb-1">{copy.comentariu}</label>
      <textarea id="comentariu" name="comentariu" rows="3" class="w-full rounded-lg border border-ink-100 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500"></textarea>
    </div>

    <label class="flex items-start gap-2 text-sm text-ink-700">
      <input type="checkbox" required class="mt-1 accent-brand-500" />
      <span>{copy.consimtPre} <a href={localizedHref(lang, '/politica-de-confidentialitate')} class="text-brand-600 underline">{copy.consimtLink}</a>{copy.consimtPost}</span>
    </label>

    <button type="submit" class="justify-self-start bg-brand-500 hover:bg-brand-600 text-white font-heading font-semibold rounded-lg px-8 py-3 transition-colors">
      {copy.submit}
    </button>

    <p class="form-success hidden text-brand-700 bg-brand-50 border border-brand-300 rounded-lg px-4 py-3 text-sm">
      {copy.success}
    </p>
    <p class="form-error hidden text-danger bg-red-50 border border-danger rounded-lg px-4 py-3 text-sm">
      {copy.errorPre} {SITE.email}.
    </p>
  </form>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('form.request-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const successEl = form.querySelector('.form-success');
      const errorEl = form.querySelector('.form-error');
      successEl?.classList.add('hidden');
      errorEl?.classList.add('hidden');
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitBtn) submitBtn.disabled = true;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const data = await res.json();
        if (data.success) {
          form.reset();
          successEl?.classList.remove('hidden');
        } else {
          errorEl?.classList.remove('hidden');
        }
      } catch {
        errorEl?.classList.remove('hidden');
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  });
</script>
