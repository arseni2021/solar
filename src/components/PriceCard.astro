---
import { Icon } from 'astro-icon/components';
import { UI, type Lang } from '../lib/i18n';

interface Props {
  icon: string;
  name: string;
  tagline: string;
  description: string;
  href: string;
  lang?: Lang;
}
const { icon, name, tagline, description, href, lang = 'ro' } = Astro.props;
---
<a href={href} class="block bg-white rounded-2xl shadow-sm hover:shadow-md border border-ink-100 p-6 transition-shadow group">
  <span class="inline-flex items-center justify-center rounded-full bg-brand-100 p-3 mb-4">
    <Icon name={icon} class="w-6 h-6 text-brand-500" />
  </span>
  <h3 class="font-heading font-semibold text-lg text-ink-900 mb-1">{name}</h3>
  <p class="text-brand-600 font-medium mb-3">{tagline}</p>
  <p class="text-ink-700 mb-4">{description}</p>
  <span class="inline-flex items-center gap-1 text-brand-600 font-semibold group-hover:gap-2 transition-all">
    {UI[lang].viewDetails} <Icon name="lucide:arrow-right" class="w-4 h-4" />
  </span>
</a>
